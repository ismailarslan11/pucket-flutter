# AdMob prod ID'leri — tool/setup_admob.sh ile projeye uygulanır.
# Kopyala: cp tool/admob.env.example tool/admob.env
#
# AdMob Console (https://admob.google.com):
#   1) Uygulama ekle → Android → com.yesastudio.pucket
#   2) Uygulama ekle → iOS → com.pucket.pucketFlutter
#   3) Her uygulama için reklam birimleri oluştur:
#      Banner, Interstitial (geçiş), Rewarded (ödüllü)
#
# Firebase bağlantısı (isteğe bağlı ama önerilir):
#   Firebase Console → pucket-202607 → Proje ayarları → Entegrasyonlar → AdMob

# ── Android (com.yesastudio.pucket) ──
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/1111111111
ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/2222222222
ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/3333333333

# ── iOS (com.pucket.pucketFlutter) ──
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~ZZZZZZZZZZ
ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/4444444444
ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/5555555555
ADMOB_IOS_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/6666666666
